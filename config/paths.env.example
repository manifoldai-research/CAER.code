# Copy to config/paths.env and replace every /path/to/... value.
#   cp config/paths.env.example config/paths.env
# paths.env is gitignored. See docs/TRAINING.md.

# Python environments. They must already contain the dependencies documented in README.md.
CAP_PYTHON_BIN=/path/to/cap-env/bin/python
LIBERO_PYTHON_BIN=/path/to/libero-env/bin/python
LIBERO_TORCHRUN_BIN=/path/to/libero-env/bin/torchrun

# All new runs are created below this directory unless OUTPUT_DIR is set.
OUTPUT_ROOT=/path/to/training-outputs

# Arm and Camera use the same prepared Wan2.2 TI2V control initialization.
# Its config.json/weights must describe either 48 input channels (expanded at startup)
# or the prepared 100-channel control input.
CAP_CONTROL_MODEL=/path/to/ti2v_control_init_model

# Arm metadata is a top-level JSON array. Each item needs file_path, ann_file,
# control_type=arm, and 14-D state annotations covering the selected frames.
ARM_METADATA=/path/to/arm/metadata.json
ARM_DATA_ROOT=/
# Leave empty to reproduce the current Arm ablation launcher. Set only when the
# supplied Arm dataset requires percentile normalization from this JSON file.
ARM_ACTION_STAT_PATH=

# Camera metadata is a top-level JSON array. Each item needs a target video and
# an aligned processed camera-pose .txt control file.
CAMERA_METADATA=/path/to/camera/metadata.json
CAMERA_DATA_ROOT=/

# PoseAnything starts from the original 48-channel Wan2.2-TI2V-5B model.
POSE_BASE_MODEL=/path/to/Wan2.2-TI2V-5B
POSE_METADATA=/path/to/xpose/processed/metadata_poseanything.json
POSE_DATA_ROOT=/

# LIBERO_ASSETS_DIR must contain all four paths below:
#   metadata_libero_single_arm_train.json
#   stat.json
#   ti2v_control_init_model/config.json and its weight shards
#   annotation/train/*.json referenced by the metadata
LIBERO_ASSETS_DIR=/path/to/libero_single_arm_ablation
LIBERO_TRAIN_DATA_ROOT=/

